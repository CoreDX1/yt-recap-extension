{
  "manifest_version": 3,
  "name": "YouTube & YT Music Recap",
  "version": "2.2.1",
  "description": "Recaps en tiempo real de YouTube y YouTube Music con calendario, canales, likes, búsquedas y exportación ZIP/PNG.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://*.ytimg.com/*",
    "https://*.googleusercontent.com/*",
    "https://yt3.ggpht.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ver mi Recap"
  }
}
